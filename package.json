{
  "name": "ppalli-naga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:net && npm run test:room && npm run test:ragdoll && npm run test:swap && npm run test:explosion && npm run test:game && npm run test:ball",
    "test:net": "node test/net-test.js",
    "test:ragdoll": "esbuild test/ragdoll-test.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.build/ragdoll-test.mjs && node test/.build/ragdoll-test.mjs",
    "test:swap": "esbuild test/control-swap-test.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.build/control-swap-test.mjs && node test/.build/control-swap-test.mjs",
    "test:explosion": "esbuild test/explosion-repro-test.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.build/explosion-repro-test.mjs && node test/.build/explosion-repro-test.mjs",
    "test:game": "esbuild test/game-loop-test.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.build/game-loop-test.mjs && node test/.build/game-loop-test.mjs",
    "test:room": "node test/room-test.js",
    "test:ball": "esbuild test/ball-test.ts --bundle --platform=node --format=esm --packages=external --outfile=test/.build/ball-test.mjs && node test/.build/ball-test.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.169.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
